# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]

# Virtual environments
venv/
venv_win/
.venv/

# Logs
*.log

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS
.DS_Store

# Claude Code internal
.claude/

# Audit / database files (contain PII and business data — do not commit)
data/*.sqlite
data/*.db
data/*.sqlite-shm
data/*.sqlite-wal
# Keep directory marker
!data/.gitkeep

# Runtime price caches under utils/ (regenerated at runtime — not seed data)
utils/*.db
utils/price_db.json
utils/known_parts.json
# utils/ must never hold a registry DB — the live store is data/supplier_registry.sqlite
# (a 0-byte utils/ copy once appeared here by mistake; this keeps it from re-landing).
utils/supplier_registry.sqlite

# Frontend — build artefacts, dependencies, and local env overrides (never commit)
frontend/node_modules/
frontend/.next/
frontend/.turbo/
frontend/.env.local
frontend/tsconfig.tsbuildinfo
